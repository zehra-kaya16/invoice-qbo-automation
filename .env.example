APP_ENV=development
APP_SECRET_KEY=change-me

# QuickBooks Online
QBO_CLIENT_ID=your-qbo-client-id
QBO_CLIENT_SECRET=your-qbo-client-secret
QBO_REDIRECT_URI=http://localhost:8000/api/qbo/callback
QBO_ENVIRONMENT=sandbox
# Generate once with Fernet.generate_key(); keep the same key across restarts.
QBO_TOKEN_ENCRYPTION_KEY=

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/receipt_ai

# Redis (for Celery background tasks)
REDIS_URL=redis://localhost:6379/0

# AI Extraction
OPENAI_API_KEY=sk-your-openai-key

# Or use Anthropic
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Local HTTP: false. HTTPS deployment: true.
AUTH_COOKIE_SECURE=false
AUTH_SESSION_HOURS=12
