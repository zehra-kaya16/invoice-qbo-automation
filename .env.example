
# QuickBooks Online
QBO_CLIENT_ID=your-qbo-client-id
QBO_CLIENT_SECRET=your-qbo-client-secret
QBO_REDIRECT_URI=http://localhost:8000/api/qbo/callback
QBO_ENVIRONMENT=sandbox
# Generate once with Fernet.generate_key(); keep the same key across restarts.
QBO_TOKEN_ENCRYPTION_KEY=

# Database
DATABASE_URL=sqlite:///./receipt_ai.db

# Redis (for Celery background tasks)
REDIS_URL=redis://localhost:6379/0

# AI Extraction
OPENAI_API_KEY=sk-your-openai-key

# Or use Anthropic
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Local HTTP: false. HTTPS deployment: true.
AUTH_COOKIE_SECURE=false
AUTH_SESSION_HOURS=12

# Document input limits
MAX_UPLOAD_BYTES=20971520
MAX_PDF_PAGES=50
MAX_HEIC_PIXELS=40000000

# Select explicitly when both providers are configured.
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o
# Anthropic: AI_PROVIDER=anthropic, AI_MODEL=claude-sonnet-4-6

# Private source objects (originals, check images, converted QBO attachments)
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./uploads
# Keep this identity when moving/restoring the complete local object tree.
LOCAL_STORAGE_ID=receipt-ai-local-v1
# S3: set STORAGE_TYPE=s3. Default AWS credential chain also supports IAM roles.
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Optional S3-compatible endpoint (HTTPS in deployed environments)
S3_ENDPOINT=
# R2: set STORAGE_TYPE=r2 and provide R2 S3 API credentials.
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=

# Signed inbound integrations and transactional email outbox
WEBHOOK_DOWNLOAD_HOSTS=
EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SENDGRID_API_KEY=
RESEND_API_KEY=
POSTMARK_API_KEY=

# Docker: run prepare_docker.py, then use .env.compose + .env.docker.
# Compose supplies DATABASE_URL, REDIS_URL, DEPLOYMENT_MODE and container paths.
# .env.docker is raw: values must not be wrapped in quotes.
